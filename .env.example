API_BASE_URL=
AI_SERVICE_URL=
MODEL_ENDPOINT=
DATABASE_URL=
AUTH_KEY=
# Public web proof of concept (web/.env.local — Git-ignored; real values are
# never committed). Team inbox that receives waiting-list and partnership
# enquiries via the visitor's own email app. Until set, the Join form falls back
# to the disabled state when the secure waiting list below is unconfigured.
VITE_CONTACT_EMAIL=

# Secure waiting list (Supabase Auth magic link + RLS-protected signups).
# Both values are PUBLIC by design: they ship inside the browser bundle and are
# protected by Row Level Security. A service_role key, an sb_secret_ key, a
# database password or a personal access token must never appear here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<project publishable key>

# ---------------------------------------------------------------------------
# Optional web/ overrides. Every value below has a working built-in default, so
# leave these COMMENTED OUT unless you are deliberately overriding something.
# Do not assign an empty value: the MediaPipe options are read with `??`, so an
# empty string would replace the default (and its URL) instead of falling back.
# ---------------------------------------------------------------------------

# Large-asset hosting. The two ~179 MiB ONNX external-data sidecars are not
# committed (the ~48 MiB production avatar GLB is), so point these at an object-storage
# host. Keep each model beside its `.data` file: the sidecar is fetched from
# `${modelUrl}.data`.
# Defaults: /spoter_pilot.onnx | /spoter_v2_model.onnx | /avatar/SignVox_Female_Competition_Prototype.glb
#VITE_SPOTER_PILOT_URL=
#VITE_SPOTER_V2_URL=
#VITE_AVATAR_GLB_URL=

# MediaPipe Tasks assets. Defaults are the public jsDelivr WASM root and the
# Google-hosted .task landmarker models.
#VITE_MEDIAPIPE_WASM_ROOT=
#VITE_MEDIAPIPE_POSE_MODEL_URL=
#VITE_MEDIAPIPE_HAND_MODEL_URL=
#VITE_MEDIAPIPE_FACE_MODEL_URL=
# Landmarker delegate: GPU (default) or CPU; falls back to CPU automatically.
#VITE_MEDIAPIPE_DELEGATE=

# ONNX Runtime: set to 1 to fetch the WASM runtime through the proxy worker.
#VITE_ORT_WASM_PROXY=
